# Build products
build/*.obj
build/*.exe
build/*.map
build/*.lst
build/KERNEL.SYS
build/kernel-build/

# Release images and checksums
dist/*.img
dist/*.zip
dist/*.iso
dist/*.sha256

# Floppy staging payload (gathered from upstream at build time)
floppy/payload/
floppy/*.bin

# Download cache for scripts/fetch-payload.sh (FreeDOS archives)
.payload-cache/

# Transient DOS test output
TESTOUT.TXT

# Vendored third-party binaries (gathered at build time; source per LICENSES/)
third_party/*/
!third_party/README.md

# Editor / OS noise
*.swp
*~
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc

# stray object files from ad-hoc wcl/wcc invocations
*.o
